{
  "name": "crorepati-revision-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "pipeline": "node scripts/build-content.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:strict": "node scripts/validate.mjs --strict-coverage --strict-sources",
    "audit:coverage": "node scripts/validate.mjs --strict-coverage",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run pipeline && npm run validate && npm test && npm run build",
    "check:release": "npm run check && npm run validate:strict && npm run test:e2e",
    "checkpoint": "node scripts/checkpoint.mjs",
    "apply-batch": "node scripts/question-batch.mjs"
  },
  "dependencies": {
    "idb": "8.0.3",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
